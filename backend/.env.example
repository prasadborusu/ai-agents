# ==============================================================================
# BYTE4 AI — REMEMBR Environment Configuration
# ==============================================================================

# Application
PROJECT_NAME="BYTE4 AI — REMEMBR"
TAGLINE="Every repair becomes knowledge."
API_V1_STR="/api"
ENVIRONMENT="development"

# Database Configuration
# Local SQLite database (default for development)
DATABASE_URL="sqlite+aiosqlite:///./remembr.db"

# Supabase (Optional - fill in if connecting to Supabase cloud)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Hindsight by Vectorize (Persistent AI Memory)
HINDSIGHT_BASE_URL="http://localhost:8888"
HINDSIGHT_API_KEY=
HINDSIGHT_DEFAULT_BANK="org_byte4_default"


# Hugging Face Configuration (Serverless Inference & Hub Models)
# Popular models:
# - meta-llama/Llama-3.3-70B-Instruct
# - Qwen/Qwen2.5-72B-Instruct
# - mistralai/Mistral-7B-Instruct-v0.3
# - deepseek-ai/DeepSeek-R1-Distill-Qwen-32B
HUGGINGFACE_API_KEY=
HUGGINGFACE_MODEL="meta-llama/Llama-3.3-70B-Instruct"
HUGGINGFACE_API_URL="https://router.huggingface.co/v1/chat/completions"

# URLs & CORS
FRONTEND_URL="http://localhost:5173"
BACKEND_URL="http://localhost:8000"

# Security & Authentication
JWT_SECRET="remembr-byte4-enterprise-secret-key-change-in-production"
ACCESS_TOKEN_EXPIRE_MINUTES=10080
